---
// Starlight's default footer, plus a copyright line.
import Default from "@astrojs/starlight/components/Footer.astro";
---

<Default />
<p class="copyright">
	© 2026 <a href="https://www.jithins.dev/" rel="author">Jithin Sebastian</a> ·
	<a href="https://github.com/jithinsk/emdash-header-footer-code/blob/main/LICENSE" rel="license">MIT License</a> ·
	<a href="https://github.com/jithinsk/emdash-header-footer-code">GitHub</a>
</p>

<style>
	.copyright {
		margin-top: 1.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
	.copyright a {
		color: inherit;
	}
</style>
